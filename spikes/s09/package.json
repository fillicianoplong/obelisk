{
  "name": "obelisk-spike-s09",
  "private": true,
  "version": "0.0.0",
  "description": "Throwaway checks for .docx files built with the docx library. Not part of the Obelisk app and not shipped.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/run-spike.js",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "docx": "9.14.0",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
