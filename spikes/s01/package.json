{
  "name": "obelisk-spike-s01",
  "private": true,
  "version": "0.0.0",
  "description": "Throwaway check for MSIX writes and the atomic rename. Not part of the Obelisk app and not shipped.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "start": "npm run build && node dist/run-spike.js",
    "packaged": "npm run build && node dist/run-packaged.js",
    "package:msix": "node package-msix.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
