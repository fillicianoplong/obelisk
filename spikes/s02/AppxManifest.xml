<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">
  <Identity
    Name="Obelisk.SpikeS02"
    Publisher="CN=Obelisk Dev"
    Version="0.0.1.0"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Obelisk Spike S-02</DisplayName>
    <PublisherDisplayName>Obelisk Dev</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="SpikeS02" Executable="ObeliskSpikeS02.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Obelisk Spike S-02"
        Description="Throwaway check for Explorer open and the second instance."
        BackgroundColor="transparent"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="s02obk">
            <uap:SupportedFileTypes>
              <uap:FileType>.s02obk</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Obelisk Spike S-02 Document</uap:DisplayName>
            <uap:Logo>assets\Square44x44Logo.png</uap:Logo>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="ObeliskSpikeS02.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
