@startuml obelisk_class
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam dpi 140
hide methods
hide empty members
class Manifest {
  format: obelisk
  formatVersion: 1
  writer
}
class Document {
  view: pages | pageless
}
class PageSetup {
  paper: Letter
  orientation
  margins: inches
}
class HeaderFooter {
  one paragraph
  page fields
}
abstract class Block {
  id: UUID v4
  type
}
class TextBlock {
  paragraph, heading,
  list, quote, code
}
class DividerBlock
class PageBreakBlock
class TableBlock {
  up to 200 x 26
  column widths
}
class Cell {
  text or formula
}
class ImageBlock {
  sha256, width: inches
  rotation, flips, alt
}
class FormulaBlock {
  latex
}
class ColumnRow <<Should>> {
  2 to 4 columns
}
class DrawingBlock <<Should>> {
  strokes
}
class SignatureBlock <<Should>> {
  PNG sha256, label
}
class DiagramBlock <<Should>> {
  mermaid source
}
class DrawingLayer <<Should>> {
  strokes
}
class Image {
  sha256, type
  bytes, width, height
  frames
}
Manifest "1" *-- "0..*" Image
Document "1" *-- "1" PageSetup
Document "1" *-- "2" HeaderFooter
Document "1" *-- "0..*" Block
Block <|-- TextBlock
Block <|-- DividerBlock
Block <|-- PageBreakBlock
Block <|-- TableBlock
Block <|-- ImageBlock
Block <|-- FormulaBlock
Block <|-- ColumnRow
Block <|-- DrawingBlock
Block <|-- SignatureBlock
Block <|-- DiagramBlock
TableBlock "1" *-- "1..*" Cell
ColumnRow "1" *-- "2..4" Block : per column
ImageBlock "0..*" --> "1" Image
SignatureBlock "0..*" --> "1" Image
ImageBlock "1" *-- "0..1" DrawingLayer
note bottom of ColumnRow : No column rows or page breaks inside (FR-71)
note bottom of Image : frames up to 1,000 for animated GIF and WebP (OD-18)
@enduml
