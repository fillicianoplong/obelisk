@startuml obelisk_sequence_export_word
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam dpi 140
actor User
participant "Shell and Tabs" as Shell
participant "FormulaRenderer\nand BlockViews" as Formula
participant "IPC bridge" as IPC
participant "ExportService" as Exp
participant "mathml2omml" as M2O
participant "FileService" as FS
database "User folder" as Disk
User -> Shell : File > Export > Word
Shell -> Formula : MathML and PNG for each formula;\nfirst-frame PNG for each animated image
Formula --> Shell : assets
Shell -> IPC : export:run(word, handle, document, assets)
IPC -> FS : Export dialog and replace prompt
alt user cancels
  FS --> Shell : cancelled
else target chosen
  FS --> Exp : target
  Exp -> Exp : export(word, document, assets, target)
  loop each formula
    alt Word equations built and conversion ok (FR-57)
      Exp -> M2O : convert(MathML)
      M2O --> Exp : OMML
    else converter missing or fails (FR-56)
      Exp -> Exp : embed PNG image
    end
  end
  Exp -> FS : writeAtomic(.docx bytes)
  FS -> Disk : temp file, then rename
  alt done within 60 s
    Exp --> Shell : ok(name, formulasAsImages)
  else timeout or error
    Exp --> Shell : timeout or error; no partial file
  end
end
note over Exp : The .obk file is never written (FR-66)
@enduml
